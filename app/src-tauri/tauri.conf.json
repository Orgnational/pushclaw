{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pushover Toolkit",
  "version": "0.5.0",
  "identifier": "com.orgnational.pushover-toolkit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pushover Toolkit",
        "width": 780,
        "height": 640,
        "minWidth": 520,
        "minHeight": 420,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
